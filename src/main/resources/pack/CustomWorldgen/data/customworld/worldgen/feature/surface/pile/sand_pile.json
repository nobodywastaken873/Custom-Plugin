{
  "type": "minecraft:block_pile",
    "state_provider": {
      "type": "minecraft:rule_based",
      "rules": [
        {
          "if_true": {
            "type": "minecraft:any_of",
            "predicates": [
              {
                "type": "minecraft:matching_blocks",
                "offset": [
                  0,
                  -1,
                  0
                ],
                "blocks": "minecraft:sand"
              },
              {
                "type": "minecraft:matching_blocks",
                "offset": [
                  0,
                  -2,
                  0
                ],
                "blocks": "minecraft:sand"
              }
            ]
          },
          "then": {
            "type": "minecraft:simple",
            "state": {
              "id": "minecraft:sand"
            }
          }
        },
        {
          "if_true": {
            "type": "minecraft:any_of",
            "predicates": [
              {
                "type": "minecraft:matching_blocks",
                "offset": [
                  0,
                  -1,
                  0
                ],
                "blocks": "minecraft:red_sand"
              },
              {
                "type": "minecraft:matching_blocks",
                "offset": [
                  0,
                  -2,
                  0
                ],
                "blocks": "minecraft:red_sand"
              }
            ]
          },
          "then": {
            "type": "minecraft:simple",
            "state": {
              "id": "minecraft:red_sand"
            }
          }
        },
        {
          "if_true": {
            "type": "minecraft:true"
          },
          "then": {
            "type": "minecraft:simple",
            "state": {
              "id": "minecraft:air"
            }
          }
        }
      ]
    }
}